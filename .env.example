# --- Database --------------------------------------------------------------
# In docker compose the host is the `postgres` service, not localhost.
# docker compose builds DATABASE_URL from POSTGRES_PASSWORD, so only this
# needs setting there. Set DATABASE_URL directly when running without Docker.
POSTGRES_PASSWORD=CHANGE_ME
# DATABASE_URL=postgresql+psycopg://cci:CHANGE_ME@127.0.0.1:5432/cci

# --- Security --------------------------------------------------------------
# Signs JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Telegram --------------------------------------------------------------
# Token from @BotFather. The SAME bot must own the Mini App, otherwise every
# request from the Mini App fails signature verification with 401.
TELEGRAM_BOT_TOKEN=
# The bot's @handle without the @, e.g. colafest_bot. Only used to render
# the Telegram Login Widget when the app is opened in a normal browser.
TELEGRAM_BOT_USERNAME=
# https URL of the Mini App, exactly as configured in BotFather (/newapp and
# Menu Button). Must be https and should end with a slash.
TELEGRAM_WEBAPP_URL=https://YOUR-DOMAIN/app/

# --- Cloudflare Tunnel -----------------------------------------------------
# Zero Trust -> Networks -> Tunnels -> your tunnel -> install token.
# This is how the app is reachable from the internet without binding any
# host port, so it cannot collide with anything else on the server.
TUNNEL_TOKEN=
